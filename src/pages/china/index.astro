---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExpertiseIcon from '../../components/ExpertiseIcon.astro';
import { companyMetrics, chinaSystemDisciplines, furniturePages } from '../../data/site';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title="Business with China | JM Trade Group"
  description="One-stop support across ELV, MEPF and furniture sourcing. JM Trade Group connects investors with specialist Chinese companies and coordinates sourcing and communication."
>
  <main id="main" class="china-overview">
    <section class="disciplines-section section-pad" id="disciplines" aria-labelledby="disciplines-title">
      <div class="wrap">
        <div class="disciplines-intro">
          <p class="eyebrow"><span>China services</span> · Our role</p>
          <h1 id="disciplines-title">One-stop support<br /><em>across four disciplines.</em></h1>
          <p class="disciplines-copy">We connect investors with Chinese companies, coordinate sourcing and communication. Our partners provide the products and technical expertise.</p>
        </div>

        <div class="furniture-grid" aria-label="Furniture sourcing disciplines">
          {furniturePages.map((page) => (
            <a class="furniture-card" href={withBase(page.href)}>
              <span class="furniture-photo"><img src={withBase(page.image)} alt={page.imageAlt} loading="lazy" /></span>
              <span class="furniture-copy">
                <span class="furniture-title">{page.title}</span>
                <span class="furniture-description">{page.description}</span>
                <span class="furniture-link">Explore <span aria-hidden="true">↗</span></span>
              </span>
            </a>
          ))}
        </div>

        <div class="systems-grid">
          {chinaSystemDisciplines.map((discipline) => (
            <section class="system-group" aria-labelledby={`discipline-${discipline.title.toLowerCase().replaceAll(' ', '-')}`}>
              <div class="system-group-heading">
                <h3 id={`discipline-${discipline.title.toLowerCase().replaceAll(' ', '-')}`}>{discipline.title}</h3>
                <p>{discipline.description}</p>
              </div>
              <ul class="system-icons" style={`--icon-columns:${discipline.columns}`}>
                {discipline.items.map((item) => (
                  <li class="system-service" data-searchable>
                    <span class="system-icon"><ExpertiseIcon name={item.icon} /></span>
                    <span>{item.label}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="numbers-section" style={`--numbers-bg-image: url("${withBase('/images/china-port-background.webp')}")`} aria-labelledby="numbers-title">
      <div class="numbers-shade" aria-hidden="true"></div>
      <div class="wrap numbers-content">
        <p class="eyebrow eyebrow-light"><span>China services</span> · At a glance</p>
        <div class="numbers-heading">
          <div><h2 id="numbers-title">Our company<br /><em>by the numbers.</em></h2></div>
          <p>From active projects to completed deliveries, these figures offer a snapshot of our work with clients and partners in China.</p>
        </div>
        <div class="metric-grid">
          {companyMetrics.map((metric, index) => (
            <a class="metric-card" href={withBase(metric.href)} aria-label={`${metric.label}: ${metric.value}. View details`}>
              <span class="metric-ring" aria-hidden="true">
                <svg viewBox="0 0 100 100" focusable="false">
                  <circle class="ring-track" cx="50" cy="50" r="43" pathLength="100" />
                  <circle class="ring-progress" cx="50" cy="50" r="43" pathLength="100" style={`--ring-progress: ${metric.ring}; --ring-delay: ${index * 140}ms`} />
                </svg>
                <span class="metric-value">{metric.value}</span>
              </span>
              <span class="metric-label">{metric.label}</span>
              <span class="metric-detail">{metric.detail}</span>
              <span class="metric-link">Explore <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
        <a class="back-link" href={withBase('/#services')}>← Back to all services</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .numbers-section { position: relative; isolation: isolate; min-height: 0; padding: clamp(70px, 7.5vw, 110px) 0 56px; overflow: hidden; color: white; background: #263631 var(--numbers-bg-image) center 54% / cover no-repeat; }
  .numbers-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(105deg, rgb(20 32 30 / 91%) 0%, rgb(22 38 34 / 84%) 52%, rgb(22 38 34 / 68%) 100%); }
  .numbers-content { position: relative; }
  .eyebrow-light { color: #e1eee8; }
  .eyebrow-light > span { color: #bdd7c9; }
  .numbers-heading { display: grid; grid-template-columns: 1.15fr .85fr; align-items: end; gap: clamp(40px, 8vw, 125px); }
  .numbers-heading h2 { max-width: 760px; margin: 0; font: 500 clamp(50px, 7vw, 88px)/.99 var(--display); letter-spacing: -.075em; text-wrap: balance; }
  .numbers-heading h2 em { color: #b9d1c5; font-weight: 400; }
  .numbers-heading > p { max-width: 540px; margin: 0 0 7px; color: rgb(255 255 255 / 84%); font-size: clamp(18px, 1.7vw, 22px); line-height: 1.7; }
  .metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: clamp(38px, 4vw, 58px); }
  .metric-card { position: relative; min-height: 350px; display: flex; flex-direction: column; align-items: center; padding: clamp(24px, 3vw, 38px); overflow: hidden; border: 1px solid rgb(230 244 236 / 30%); background: rgb(16 34 30 / 45%); backdrop-filter: blur(8px); text-align: center; transition: transform .25s ease, background .25s ease, border-color .25s ease; }
  .metric-card:hover { transform: translateY(-5px); border-color: rgb(230 244 236 / 72%); background: rgb(16 34 30 / 70%); }
  .metric-ring { position: relative; width: clamp(156px, 15vw, 188px); aspect-ratio: 1; display: grid; flex: 0 0 auto; place-items: center; margin-bottom: 22px; }
  .metric-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; transform: rotate(-90deg); }
  .metric-ring circle { fill: none; stroke-width: 8; }
  .ring-track { stroke: rgb(221 233 228 / 30%); }
  .ring-progress { stroke: #a9d0bd; stroke-dasharray: 0 100; stroke-linecap: round; animation: ring-fill 1.25s cubic-bezier(.2,.7,.2,1) var(--ring-delay) forwards; }
  @keyframes ring-fill { to { stroke-dasharray: var(--ring-progress) 100; } }
  .metric-value { color: white; font: 500 clamp(48px, 5vw, 62px)/1 var(--display); letter-spacing: -.07em; }
  .metric-label { font: 600 clamp(18px, 2vw, 22px)/1.3 var(--display); }
  .metric-detail { max-width: 340px; margin-top: 8px; color: rgb(255 255 255 / 78%); font-size: 16px; line-height: 1.6; }
  .metric-link { display: flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 18px; color: #d5e4dc; font-size: 15px; font-weight: 700; }
  .metric-link span { color: #b9d1c5; font-size: 18px; transition: transform .2s ease; }
  .metric-card:hover .metric-link span { transform: translate(3px, -3px); }
  .back-link { display: inline-block; margin-top: 28px; color: rgb(255 255 255 / 86%); font-size: 16px; font-weight: 600; }
  .back-link:hover { color: white; }

  .disciplines-section { padding-block: clamp(58px, 6vw, 88px); background: var(--paper); }
  .disciplines-intro { max-width: 1180px; margin: 0 auto clamp(36px, 4vw, 58px); text-align: center; }
  .disciplines-intro .eyebrow { justify-content: center; }
  .disciplines-intro h1 { max-width: 1400px; margin: 0 auto; font-size: clamp(56px, 7.3vw, 108px); font-weight: 600; letter-spacing: -.075em; line-height: .99; text-wrap: balance; }
  .disciplines-intro h1 em { color: var(--jade); font-weight: 500; }
  .disciplines-copy { max-width: 820px; margin: 31px auto 0; color: var(--ink-soft); font-size: clamp(18px, 1.8vw, 22px); line-height: 1.8; }
  .systems-grid { display: grid; grid-template-columns: 1.12fr .88fr; gap: 30px; }
  .system-group { min-width: 0; min-height: 420px; padding: clamp(34px, 3.8vw, 52px); background: #e9efeb; }
  .system-group-heading { margin-bottom: 32px; }
  .system-group-heading h3 { margin: 0 0 12px; color: var(--ink); font-size: clamp(30px, 3.2vw, 42px); font-weight: 650; letter-spacing: -.05em; }
  .system-group-heading p { max-width: 600px; margin: 0; color: var(--muted); font-size: 18px; line-height: 1.7; }
  .system-icons { display: grid; grid-template-columns: repeat(var(--icon-columns), minmax(0, 1fr)); gap: 30px 12px; margin: 0; padding: 0; list-style: none; }
  .system-service { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; color: var(--ink-soft); text-align: center; font-size: 18px; font-weight: 600; line-height: 1.45; }
  .system-icon { width: clamp(74px, 8vw, 96px); aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; color: var(--jade); background: #dce9e3; transition: transform .25s ease, color .25s ease, background .25s ease; }
  .system-service:hover .system-icon { color: white; background: var(--jade); transform: translateY(-3px); }
  .system-icon :global(.expertise-icon) { width: 49px; height: 49px; }

  .furniture-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 24px; }
  .furniture-card { min-width: 0; min-height: 380px; display: grid; grid-template-columns: 1.05fr .95fr; overflow: hidden; border: 1px solid var(--line); background: var(--surface); transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .furniture-card:hover { transform: translateY(-4px); border-color: #b7cfc2; box-shadow: 0 18px 38px rgb(27 44 38 / 10%); }
  .furniture-photo { min-height: 100%; overflow: hidden; background: var(--sage); }
  .furniture-photo img { width: 100%; height: 100%; min-height: 380px; object-fit: cover; transition: transform .65s cubic-bezier(.2,.7,.2,1); }
  .furniture-card:hover .furniture-photo img { transform: scale(1.04); }
  .furniture-copy { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(34px, 3.6vw, 48px); }
  .furniture-title { color: var(--ink); font: 600 clamp(27px, 2.8vw, 37px)/1.18 var(--display); letter-spacing: -.05em; }
  .furniture-description { margin-top: 18px; color: var(--ink-soft); font-size: 19px; line-height: 1.7; }
  .furniture-link { display: inline-flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 18px; color: var(--jade-dark); font-size: 16px; font-weight: 700; }
  .furniture-link span { color: var(--clay); font-size: 18px; transition: transform .2s ease; }
  .furniture-card:hover .furniture-link span { transform: translate(3px, -3px); }
  @media (max-width: 1050px) { .furniture-card { grid-template-columns: 1fr; } .furniture-photo img { height: 270px; min-height: 270px; } .furniture-copy { min-height: 255px; } }
  @media (max-width: 800px) { .systems-grid { grid-template-columns: 1fr; } .system-icons { grid-template-columns: repeat(5, minmax(0, 1fr)); } .systems-grid .system-group:nth-child(2) .system-icons { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .disciplines-section { padding-block: 64px; } .numbers-section { padding-top: 58px; } .numbers-heading { grid-template-columns: 1fr; gap: 20px; } .metric-grid { grid-template-columns: 1fr; gap: 12px; margin-top: 30px; } .metric-card { min-height: 310px; } .metric-ring { width: 164px; } .disciplines-intro { margin-bottom: 40px; } .disciplines-intro h1 { font-size: clamp(50px, 10.8vw, 64px); } .system-group { min-height: 0; padding: 32px 23px; } .system-icons { gap: 24px 8px; } .system-icon { width: 76px; } .system-icon :global(.expertise-icon) { width: 38px; height: 38px; } .system-service { font-size: 16px; } .furniture-grid { grid-template-columns: 1fr; gap: 22px; margin-top: 30px; } .furniture-card { grid-template-columns: 1fr 1fr; min-height: 290px; } .furniture-photo img { height: 100%; min-height: 290px; } .furniture-copy { min-height: 290px; padding: 26px; } }
  @media (max-width: 440px) { .system-icons, .systems-grid .system-group:nth-child(2) .system-icons { grid-template-columns: repeat(3, minmax(0, 1fr)); } .furniture-card { grid-template-columns: 1fr; } .furniture-photo img { height: 210px; min-height: 210px; } .furniture-copy { min-height: 205px; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } .ring-progress { animation: none; stroke-dasharray: var(--ring-progress) 100; } }
</style>
